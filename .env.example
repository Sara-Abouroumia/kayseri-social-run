# Neon / Postgres (required for app + Better Auth)
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Better Auth — https://www.better-auth.com/docs/installation
# Generate: openssl rand -base64 32
# Required in production (hosting + CI so `next build` and runtime both resolve it).
BETTER_AUTH_SECRET=""
# Public URL of the app (no trailing slash). Used server-side for cookies and callbacks.
BETTER_AUTH_URL="http://localhost:3000"

# Same origin as BETTER_AUTH_URL for the browser client (optional if you only use same-origin requests).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: comma-separated extra origins for CSRF / redirect validation (e.g. separate marketing site).
# BETTER_AUTH_TRUSTED_ORIGINS="https://admin.example.com,https://staging.example.com"

# Optional: comma-separated emails that are always platform admins (break-glass; not removable in UI).
# Must match the signup email. Restart the dev server after changing.
# PLATFORM_ADMIN_EMAILS="you@example.com,other@example.com"

# Optional: override default club social URLs (must be https)
# NEXT_PUBLIC_CLUB_INSTAGRAM_URL="https://www.instagram.com/kayserisocialrun/"
# NEXT_PUBLIC_CLUB_WHATSAPP_URL="https://chat.whatsapp.com/your-invite-code"
# RESEND_API_KEY=""
# EMAIL_FROM="Kayseri Social Run <onboarding@resend.dev>"
