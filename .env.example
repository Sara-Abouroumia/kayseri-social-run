# Neon / Postgres (required for app + Better Auth)
# Also required on Vercel for Production AND Preview (e.g. uat branch) or `next build` fails.
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Better Auth — https://www.better-auth.com/docs/installation
# Generate: openssl rand -base64 32
# Required in production (hosting + CI so `next build` and runtime both resolve it).
BETTER_AUTH_SECRET=""
# Public URL of the app (no trailing slash). Used server-side for cookies and callbacks.
BETTER_AUTH_URL="http://localhost:3000"

# Same origin as BETTER_AUTH_URL for local/production. The browser auth client uses the
# current page origin automatically, so preview deploys work even if this still points at production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Public site URL for production (include www if that is your canonical host).
# BETTER_AUTH_URL="https://www.kayserisocialrun.com"
# NEXT_PUBLIC_APP_URL="https://www.kayserisocialrun.com"

# Optional: comma-separated extra origins for CSRF / redirect validation (e.g. production + previews).
# www / non-www pairs are added automatically for each URL above.
# BETTER_AUTH_TRUSTED_ORIGINS="https://kayserisocialrun.com,https://your-uat-branch.vercel.app"

# Vercel Preview (VERCEL_ENV=preview): BETTER_AUTH_URL is ignored; the deployment URL is used instead.

# Optional: comma-separated emails for break-glass developers (always platform admins;
# bootstrap tags in system settings are only visible to these accounts). Must match signup email.
# PLATFORM_DEVELOPER_EMAILS="you@example.com"
# Legacy alias (still supported): PLATFORM_ADMIN_EMAILS

# Optional: override default club social URLs (must be https)
# NEXT_PUBLIC_CLUB_INSTAGRAM_URL="https://www.instagram.com/kayserisocialrun/"
# NEXT_PUBLIC_CLUB_WHATSAPP_URL="https://chat.whatsapp.com/your-invite-code"
# RESEND_API_KEY=""
# EMAIL_FROM="Kayseri Social Run <onboarding@resend.dev>"
